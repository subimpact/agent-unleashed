# ==============================================================================
# Agent-Unleashed Deployment & Upstream Secrets (.env)
# ==============================================================================

# GitHub Credentials (for pushing repository)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_REPO_URL=https://github.com/your-username/agent-unleashed.git

# Cloudflare Credentials (for deploying agent.subimpact.net via Wrangler)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
