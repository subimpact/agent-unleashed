{
  "unleashed-memory-injector": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "agt-ul hook-memory",
        "timeout": 10
      }
    ]
  },
  "unleashed-stop-reflection": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "agt-ul hook-reflect",
        "timeout": 10
      }
    ]
  }
}
